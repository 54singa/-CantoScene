{
  "name": "canto-scene",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm --filter @canto-scene/server dev",
    "dev:server:local": "pnpm --filter @canto-scene/server dev:local",
    "build": "tsc -b && vite build",
    "build:server": "pnpm --filter @canto-scene/server build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "typecheck:server": "pnpm --filter @canto-scene/server typecheck"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
